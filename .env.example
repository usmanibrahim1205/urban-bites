# HTTP and Socket.IO backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001

# Vite development server. Set 0.0.0.0 explicitly for a trusted LAN demonstration.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Relative paths are resolved from the project root.
DATABASE_PATH=data/ordering.sqlite

# Set true when serving through HTTPS, including TLS termination at a proxy.
SECURE_COOKIES=false

# Set a private staff password before starting the cashier demo.
STAFF_CREDENTIAL=

# Optional default printed QR origin. The staff UI can override this per browser.
# QR_BASE_URL=http://192.168.1.10:5173
