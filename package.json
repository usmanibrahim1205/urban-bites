{
  "name": "qr-restaurant-ordering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node backend/dist/server.js",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:render": "npm run build && node --test tests/render-production.ts",
    "db:init": "node backend/src/db-cli.ts init",
    "db:seed": "node backend/src/db-cli.ts seed",
    "db:demo": "node backend/src/demo-database.ts"
  },
  "dependencies": {
    "express": "^5",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "socket.io": "^4",
    "socket.io-client": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/qrcode": "^1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "eslint": "^9",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^7"
  }
}
